<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw their own start screen: the app icon on
         the brand color, which the welcome screen then continues. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_color</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_color</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
